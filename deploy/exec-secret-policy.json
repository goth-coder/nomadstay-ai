{
  "Version": "2012-10-17",
  "Statement": [{
    "Effect": "Allow",
    "Action": "secretsmanager:GetSecretValue",
    "Resource": [
      "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:OPENAI_API_KEY-*",
      "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:HOTEL_AGENT_API_KEY-*"
    ]
  }]
}
